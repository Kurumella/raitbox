# RaitBox agent server image for Dunefield sandboxes (gVisor Pods on EKS).
# Runs as root inside the gVisor sandbox, matching the MicroVM backend (Dunefield ADR-0028): gVisor is
# the isolation boundary, all Linux capabilities are dropped, privilege escalation is disabled, and the
# Pod has no service-account token and no network egress. Listens on the Pod network only (port 8080 is
# reachable solely from the Dunefield Sandbox Router, enforced by NetworkPolicy).
FROM public.ecr.aws/amazonlinux/amazonlinux:2023

# /workspace is root-owned and /root gets the owner write bit (AL2023 ships 0550): the sandbox runs as
# root with all capabilities dropped, so it has no CAP_DAC_OVERRIDE to bypass file permissions.
# dnf keeps its metadata cache and uses short timeouts: sandboxes have no network by default, so
# installing an already-present package succeeds offline and other installs fail fast instead of hanging.

RUN dnf -y upgrade --refresh \
    && dnf -y install python3.12 python3.12-pip git procps-ng ca-certificates tar gzip \
    && dnf clean packages \
    && dnf -y makecache \
    && printf 'metadata_expire=never\ntimeout=5\nretries=1\nskip_if_unavailable=True\n' >> /etc/dnf/dnf.conf \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python \
    && install -d -m 0755 /workspace \
    && chmod 0700 /root

WORKDIR /opt/raitbox
COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt
# Common tooling for code-execution and agent workloads (data analysis, tests, language server)
RUN python3 -m pip install --no-cache-dir numpy pandas matplotlib pytest python-lsp-server
COPY server.py ./raitbox_agent_server/server.py
RUN touch ./raitbox_agent_server/__init__.py

ENV PYTHONPATH=/opt/raitbox \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    RAITBOX_PLATFORM=k8s
WORKDIR /workspace
EXPOSE 8080
CMD ["python3", "-m", "uvicorn", "raitbox_agent_server.server:app", "--host", "0.0.0.0", "--port", "8080", "--no-server-header"]

# Dunefield template network profile (read by the template pipeline; spec 6.6). Default: no egress.
ARG DUNEFIELD_NETWORK=none
ARG DUNEFIELD_EGRESS_ALLOW=
LABEL dunefield.network="${DUNEFIELD_NETWORK}" dunefield.egress.allow="${DUNEFIELD_EGRESS_ALLOW}"
ARG DUNEFIELD_MODELS=
LABEL dunefield.models="${DUNEFIELD_MODELS}"
# Warm sandboxes the platform keeps ready for this template (capped per environment), and the user to run as.
ARG DUNEFIELD_WARM=0
ARG DUNEFIELD_USER=root
LABEL dunefield.warm="${DUNEFIELD_WARM}" dunefield.user="${DUNEFIELD_USER}"
# Startup working set for Nydus prefetch (comma-separated absolute paths; the pipeline bakes it into the bootstrap).
ARG DUNEFIELD_PREFETCH=
LABEL dunefield.prefetch="${DUNEFIELD_PREFETCH}"
